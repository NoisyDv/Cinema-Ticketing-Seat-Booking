<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Cinema_Ticketing___Seat_Booking.SiteMaster" %>
<!DOCTYPE html>
<html lang="th">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title><%= Server.HtmlEncode(Page.Title) %> - Cinema Ticketing</title>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@500;700&family=IBM+Plex+Sans+Thai:wght@400;500&display=swap" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" runat="server" />
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" runat="server" />
    <script>
        (function () { try { var t = localStorage.getItem("theme"); if (t) document.documentElement.setAttribute("data-theme", t); } catch (e) { } })();
    </script>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <header class="site-header">
            <a class="brand" href="<%= ResolveUrl("~/Default.aspx") %>">🎬 Cinema Ticketing</a>
            <nav class="nav" aria-label="เมนูหลัก">
                <asp:HyperLink ID="lnkMovies" runat="server" NavigateUrl="~/Default.aspx">หนังที่กำลังฉาย</asp:HyperLink>
                <asp:HyperLink ID="lnkMyBookings" runat="server" NavigateUrl="~/MyBookings.aspx" Visible="false">การจองของฉัน</asp:HyperLink>
                <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
                    <asp:HyperLink ID="lnkAdmin" runat="server" NavigateUrl="~/Admin/Default.aspx">ผู้ดูแลระบบ</asp:HyperLink>
                </asp:PlaceHolder>
                <asp:PlaceHolder ID="phGuest" runat="server">
                    <asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Login.aspx">เข้าสู่ระบบ</asp:HyperLink>
                    <asp:HyperLink ID="lnkRegister" runat="server" NavigateUrl="~/Register.aspx">สมัครสมาชิก</asp:HyperLink>
                </asp:PlaceHolder>
                <asp:PlaceHolder ID="phUser" runat="server" Visible="false">
                    <span class="user-chip">👤 <asp:Literal ID="litUserName" runat="server"></asp:Literal></span>
                    <asp:LinkButton ID="btnLogout" runat="server" CausesValidation="false" OnClick="btnLogout_Click" CssClass="chip">ออกจากระบบ</asp:LinkButton>
                </asp:PlaceHolder>
                <button type="button" id="themeToggle" class="chip" aria-label="สลับธีมมืด/สว่าง">🌓 ธีม</button>
            </nav>
        </header>
        <main>
            <asp:Repeater ID="rptFlash" runat="server">
                <ItemTemplate>
                    <div class='alert <%# (bool)Eval("IsError") ? "err" : "ok" %>' role="alert"><%# Fmt.Html(Eval("Text")) %></div>
                </ItemTemplate>
            </asp:Repeater>
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>
        <footer class="site-footer">Cinema Ticketing &amp; Seat Booking · โครงงานวิชาระบบฐานข้อมูล 2569</footer>
    </form>
    <script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script>
</body>
</html>
