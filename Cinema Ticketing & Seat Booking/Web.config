<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<appSettings>
		<!-- รหัสด่านแอดมิน (รหัสเดียวใช้ร่วมกันทั้งทีม เปลี่ยนได้ที่นี่ไม่ต้อง build ใหม่) -->
		<add key="AdminPasscode" value="Admin-7391" />
	</appSettings>

	<connectionStrings>
		<!-- ใช้ .\SQLEXPRESS เพื่อให้รันได้ทั้งบนเครื่องนี้ (ARCH-TWIN) และเครื่องอื่นที่มี SQL Server Express -->
		<add name="MoviesConnectionString" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CinemaDB;Integrated Security=True;Persist Security Info=True;TrustServerCertificate=True"
		providerName="System.Data.SqlClient" />
	</connectionStrings>
	
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Pages/Movies.aspx" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>