<?xml version="1.0" encoding="utf-8"?>
<!--
  ตั้งค่าเว็บแอป Cinema Ticketing & Seat Booking (ASP.NET Web Forms, .NET Framework 4.7.2)
  ไม่มีแพ็กเกจ NuGet ที่ต้อง restore
-->
<configuration>
  <connectionStrings>
    <!-- ค่าเริ่มต้น: SQL Server LocalDB (มากับ Visual Studio) ฐานข้อมูลชื่อ CinemaTicketingDb
         ถ้าใช้ SQL Server เต็มรูปแบบ ให้แก้เป็นอย่างใดอย่างหนึ่งต่อไปนี้ (ดู README):
           Data Source=.\SQLEXPRESS;Initial Catalog=CinemaTicketingDb;Integrated Security=True;
           Data Source=localhost;Initial Catalog=CinemaTicketingDb;User ID=...;Password=...;  -->
    <add name="CinemaDb"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=CinemaTicketingDb;Integrated Security=True;Connect Timeout=15;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- ใช้ validator แบบคลาสสิก (ไม่ต้องใช้ jQuery) ให้การตรวจฝั่งไคลเอนต์ทำงานครบ -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="2048" enableVersionHeader="false" />
    <authentication mode="None" />
    <!-- ผู้ใช้ไม่เห็น stack trace: ข้อผิดพลาดที่ไม่คาดคิดจะไปหน้า Error.aspx (ตั้งเป็น Off เฉพาะตอนดีบัก) -->
    <customErrors mode="On" defaultRedirect="~/Error.aspx" />
    <sessionState mode="InProc" timeout="30" cookieless="false" />
    <httpCookies httpOnlyCookies="true" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <!-- ให้ markup (.aspx) เรียกใช้ Fmt ฯลฯ ได้โดยตรง -->
        <add namespace="Cinema_Ticketing___Seat_Booking" />
      </namespaces>
    </pages>
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
